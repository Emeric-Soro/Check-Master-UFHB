{% extends 'layout/admin.twig' %}

{% block title %}Rôles Temporaires - CheckMaster{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    {# En-tête #}
    <div class="mb-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                    <i class="fas fa-clock mr-3 text-purple-600"></i>
                    Gestion des Rôles Temporaires
                </h1>
                <p class="text-gray-600 mt-2">Attribuez des rôles temporaires pour des événements spécifiques</p>
            </div>
            <div class="flex gap-2">
                <a href="?page=parametres_generaux" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                    <i class="fas fa-arrow-left mr-2"></i>Retour
                </a>
                <button onclick="openCreateModal()" class="btn-primary">
                    <i class="fas fa-plus mr-2"></i>Nouveau rôle
                </button>
            </div>
        </div>
    </div>

    {# Messages de notification #}
    {% if success %}
    <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-lg" role="alert">
        <div class="flex items-center">
            <i class="fas fa-check-circle mr-2"></i>
            <p>{{ success }}</p>
        </div>
    </div>
    {% endif %}

    {% if error %}
    <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-lg" role="alert">
        <div class="flex items-center">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            <p>{{ error }}</p>
        </div>
    </div>
    {% endif %}

    {# Filtres #}
    <div class="card p-4 mb-6">
        <div class="flex flex-wrap gap-4 items-center">
            <div class="flex items-center gap-2">
                <label class="text-sm text-gray-600">Statut :</label>
                <select id="statusFilter" class="border rounded-lg px-3 py-2 text-sm" onchange="filterRoles()">
                    <option value="all">Tous</option>
                    <option value="active">Actifs</option>
                    <option value="expired">Expirés</option>
                    <option value="inactive">Désactivés</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-sm text-gray-600">Type :</label>
                <select id="typeFilter" class="border rounded-lg px-3 py-2 text-sm" onchange="filterRoles()">
                    <option value="all">Tous</option>
                    <option value="president_jury">Président Jury</option>
                </select>
            </div>
        </div>
    </div>

    {# Liste des rôles temporaires #}
    <div class="card overflow-hidden">
        <div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-4">
            <h3 class="text-lg font-semibold text-white flex items-center">
                <i class="fas fa-list mr-2"></i>
                Liste des rôles temporaires
            </h3>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="p-4 text-left text-sm font-semibold text-gray-700">Utilisateur</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-700">Rôle</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-700">Contexte</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-700">Validité</th>
                        <th class="p-4 text-center text-sm font-semibold text-gray-700">Statut</th>
                        <th class="p-4 text-center text-sm font-semibold text-gray-700">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for role in roles %}
                    <tr class="hover:bg-gray-50 transition role-row" 
                        data-status="{{ role.actif and role.valide_jusqu_a > 'now'|date('Y-m-d H:i:s') ? 'active' : (role.actif ? 'expired' : 'inactive') }}"
                        data-type="{{ role.role_code }}">
                        <td class="p-4">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center mr-3">
                                    <i class="fas fa-user text-indigo-600"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-800">{{ role.prenom_utilisateur }} {{ role.nom_utilisateur }}</p>
                                    <p class="text-sm text-gray-500">ID: {{ role.id_utilisateur }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4">
                            <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium">
                                {% if role.role_code == 'president_jury' %}
                                    <i class="fas fa-gavel mr-1"></i>Président Jury
                                {% else %}
                                    {{ role.role_code }}
                                {% endif %}
                            </span>
                        </td>
                        <td class="p-4">
                            {% if role.contexte_type %}
                                <p class="text-sm text-gray-600">
                                    {{ role.contexte_type|capitalize }} #{{ role.contexte_id }}
                                </p>
                            {% else %}
                                <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                        <td class="p-4">
                            <p class="text-sm text-gray-600">
                                <i class="fas fa-calendar mr-1"></i>
                                {{ role.valide_de|date('d/m/Y H:i') }}
                            </p>
                            <p class="text-sm text-gray-600">
                                <i class="fas fa-calendar-check mr-1"></i>
                                {{ role.valide_jusqu_a|date('d/m/Y H:i') }}
                            </p>
                        </td>
                        <td class="p-4 text-center">
                            {% if role.actif and role.valide_jusqu_a > 'now'|date('Y-m-d H:i:s') %}
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">
                                    <i class="fas fa-check-circle mr-1"></i>Actif
                                </span>
                            {% elseif role.actif %}
                                <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm">
                                    <i class="fas fa-clock mr-1"></i>Expiré
                                </span>
                            {% else %}
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                                    <i class="fas fa-times-circle mr-1"></i>Désactivé
                                </span>
                            {% endif %}
                        </td>
                        <td class="p-4 text-center">
                            <div class="flex justify-center gap-2">
                                <button onclick="viewDetails({{ role.id_role_temp }})" 
                                        class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition"
                                        title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </button>
                                {% if role.actif %}
                                <button onclick="deactivateRole({{ role.id_role_temp }})" 
                                        class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition"
                                        title="Désactiver">
                                    <i class="fas fa-ban"></i>
                                </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="p-8 text-center text-gray-500">
                            <i class="fas fa-inbox text-4xl mb-3 text-gray-300"></i>
                            <p>Aucun rôle temporaire trouvé</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Informations #}
    <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
        <h4 class="font-semibold text-blue-800 mb-2">
            <i class="fas fa-info-circle mr-2"></i>À propos des rôles temporaires
        </h4>
        <ul class="text-sm text-blue-700 space-y-1">
            <li><strong>Président de Jury</strong> - Rôle attribué automatiquement lors de la planification d'une soutenance</li>
            <li>Les rôles temporaires permettent d'accorder des permissions spécifiques pour une durée limitée</li>
            <li>Un code d'accès est envoyé par email à l'utilisateur pour activer son rôle temporaire</li>
        </ul>
    </div>
</div>

{# Modal de création #}
<div id="createModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl max-w-md w-full mx-4 overflow-hidden">
        <div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-4">
            <h3 class="text-lg font-semibold text-white">
                <i class="fas fa-plus-circle mr-2"></i>Nouveau rôle temporaire
            </h3>
        </div>
        <form method="POST" action="?page=parametres_generaux&action=create_temporary_role" class="p-6">
            {{ csrf_field|raw }}
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Utilisateur</label>
                    <select name="id_utilisateur" required class="w-full border rounded-lg px-3 py-2">
                        <option value="">Sélectionner un utilisateur</option>
                        {% for user in users %}
                        <option value="{{ user.id_utilisateur }}">{{ user.prenom_utilisateur }} {{ user.nom_utilisateur }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Type de rôle</label>
                    <select name="role_code" required class="w-full border rounded-lg px-3 py-2">
                        <option value="president_jury">Président de Jury</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Date de validité</label>
                    <input type="date" name="date_validite" required class="w-full border rounded-lg px-3 py-2">
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" onclick="closeCreateModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition">
                    Annuler
                </button>
                <button type="submit" class="btn-primary">
                    <i class="fas fa-check mr-2"></i>Créer
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function openCreateModal() {
    document.getElementById('createModal').classList.remove('hidden');
}

function closeCreateModal() {
    document.getElementById('createModal').classList.add('hidden');
}

function filterRoles() {
    const statusFilter = document.getElementById('statusFilter').value;
    const typeFilter = document.getElementById('typeFilter').value;
    
    document.querySelectorAll('.role-row').forEach(row => {
        const rowStatus = row.dataset.status;
        const rowType = row.dataset.type;
        
        const matchStatus = statusFilter === 'all' || rowStatus === statusFilter;
        const matchType = typeFilter === 'all' || rowType === typeFilter;
        
        row.style.display = matchStatus && matchType ? '' : 'none';
    });
}

function viewDetails(roleId) {
    // TODO: Implémenter la visualisation des détails
    alert('Détails du rôle #' + roleId);
}

function deactivateRole(roleId) {
    if (confirm('Êtes-vous sûr de vouloir désactiver ce rôle temporaire ?')) {
        window.location.href = '?page=parametres_generaux&action=deactivate_role&role_id=' + roleId;
    }
}

// Fermer le modal en cliquant à l'extérieur
document.getElementById('createModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeCreateModal();
    }
});
</script>
{% endblock %}
