RewriteEngine On
# RewriteBase will work for both root and subdirectory installations
# If deployed in a subdirectory, update this to match the subdirectory path
RewriteBase /public/

# Redirect to index.php if file or directory doesn't exist
# This allows static assets (CSS, JS, images) to be served directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]