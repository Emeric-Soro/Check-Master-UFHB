    public function index()
    {
        // RÃ©cupÃ©rer les Ã©tudiants non inscrits
        $GLOBALS['etudiantsNonInscrits'] = $this->scolariteModel->getEtudiantsNonInscrits();

        // RÃ©cupÃ©rer les niveaux d'Ã©tudes
        $GLOBALS['niveaux'] = $this->scolariteModel->getNiveauxEtudes();

        // RÃ©cupÃ©rer les Ã©tudiants dÃ©jÃ  inscrits
        $GLOBALS['etudiantsInscrits'] = $this->scolariteModel->getEtudiantsInscrits();

        // RÃ©cupÃ©rer les Ã©tudiants non inscrits pour le formulaire d'inscription
        $GLOBALS['etudiantsNonInscrits'] = $this->scolariteModel->getEtudiantsNonInscrits();

        // RÃ©cupÃ©rer la liste complÃ¨te des Ã©tudiants
        $GLOBALS['listeAllEtudiant'] = $this->scolariteModel->getAllEtudiants();

        // RÃ©cupÃ©rer les annÃ©es acadÃ©miques
        $GLOBALS['listeAnnees'] = $this->anneeAcademique->getAllAnneeAcademiques();

        // RÃ©cupÃ©rer l'annÃ©e acadÃ©mique active pour l'afficher
        $GLOBALS['anneeAcademiqueActive'] = $this->anneeAcademique->getAnneeAcademiqueActive();

        // Si un numÃ©ro d'Ã©tudiant est fourni, rÃ©cupÃ©rer ses informations
        if (isset($_GET['num_etu'])) {
            $GLOBALS['etudiantInfo'] = $this->scolariteModel->getInfoEtudiant($_GET['num_etu']);
        }

        // Si on est en mode modification, rÃ©cupÃ©rer les informations du versement
        if (isset($_GET['action']) && $_GET['action'] === 'mettre_a_jour_versement' && isset($_GET['id'])) {
            $versement = $this->scolariteModel->getVersementById($_GET['id']);
            if ($versement && $versement['type_versement'] === 'Tranche') {
                $GLOBALS['versementAModifier'] = $versement;
            } else {
                $GLOBALS['messageErreur'] = "Ce versement ne peut pas Ãªtre modifiÃ©.";
            }
        }

        // Traiter la soumission du formulaire
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            if (isset($_GET['action'])) {
                switch ($_GET['action']) {
                    case 'creer_inscription':
                        $this->creerInscription();
                        break;
                    case 'enregistrer_versement':
                        $this->enregistrerVersement();
                        break;
                    case 'enregistrer_paiement':
                        $this->enregistrerPaiement();
                        break;
                    case 'mettre_a_jour_versement':
                        $this->mettreAJourVersement();
                        break;

                }
            }
        }

        // RÃ©cupÃ©rer la liste des versements
        $GLOBALS['listeVersement'] = $this->scolariteModel->getAllVersements();
    }

    public function creerInscription()
    {
        try {
            // Validation des donnÃ©es
            if (
                empty($_POST['etudiant']) || empty($_POST['niveau']) ||
                empty($_POST['annee_academique']) || empty($_POST['premier_versement']) ||
                empty($_POST['methode_paiement'])
            ) {
                $GLOBALS['messageErreur'] = "Tous les champs obligatoires doivent Ãªtre remplis.";
                return;
            }

            $id_etudiant = $_POST['etudiant'];
            $id_niveau = $_POST['niveau'];
            $id_annee_acad = $_POST['annee_academique'];
            $montant_premier_versement = floatval($_POST['premier_versement']);
            $methode_paiement = $_POST['methode_paiement'];
            $num_piece = isset($_POST['num_piece']) ? $_POST['num_piece'] : null;

            // RÃ©cupÃ©rer le montant total de la scolaritÃ©
            $montant_total = $this->scolariteModel->getMontantScolarite($id_niveau);

            // VÃ©rifier que le premier versement ne dÃ©passe pas le montant total
            if ($montant_premier_versement > $montant_total) {
                $GLOBALS['messageErreur'] = "Le montant du premier versement ne peut pas dÃ©passer le montant total de la scolaritÃ© (" . number_format($montant_total, 0, ',', ' ') . " FCFA).";
                return;
            }

            // CrÃ©er l'inscription avec le premier versement (=crÃ©er une ligne dans inscriptions)
            $id_inscription = $this->scolariteModel->creerInscription(
                $id_etudiant,
                $id_niveau,
                $id_annee_acad,
                $montant_premier_versement,
                $methode_paiement,
                $num_piece
            );

            if ($id_inscription) {
                $reste_a_payer = $montant_total - $montant_premier_versement;
                $GLOBALS['messageSuccess'] = "Inscription crÃ©Ã©e avec succÃ¨s. Premier versement de " . number_format($montant_premier_versement, 0, ',', ' ') . " FCFA enregistrÃ©. Reste Ã  payer : " . number_format($reste_a_payer, 0, ',', ' ') . " FCFA.";
                $this->auditLog->logCreation($_SESSION['id_utilisateur'], "inscriptions", 'SuccÃ¨s');

                // RafraÃ®chir les listes
                $GLOBALS['etudiantsInscrits'] = $this->scolariteModel->getEtudiantsInscrits();
                $GLOBALS['etudiantsNonInscrits'] = $this->scolariteModel->getEtudiantsNonInscrits();
            } else {
                $GLOBALS['messageErreur'] = "Erreur lors de la crÃ©ation de l'inscription.";
                $this->auditLog->logCreation($_SESSION['id_utilisateur'], "inscriptions", 'Erreur');
            }
        } catch (Exception $e) {
            error_log("Erreur dans creerInscription : " . $e->getMessage());
            $GLOBALS['messageErreur'] = "Une erreur est survenue : " . $e->getMessage();
        }
    }

    public function enregistrerVersement()
    {
        try {
            // Validation des donnÃ©es
            if (
                empty($_POST['id_etudiant']) || empty($_POST['montant']) ||
                empty($_POST['methode_paiement']) || empty($_POST['date_versement'])
            ) {
                $GLOBALS['messageErreur'] = "Tous les champs obligatoires doivent Ãªtre remplis.";
                return;
            }

            $id_etudiant = $_POST['id_etudiant'];
            $montant = floatval($_POST['montant']);
            $methode_paiement = $_POST['methode_paiement'];
            $date_versement = $_POST['date_versement'];
            $num_piece = isset($_POST['num_piece']) ? $_POST['num_piece'] : null;

            // RÃ©cupÃ©rer les informations de la derniÃ¨re inscription de l'Ã©tudiant
            $derniere_inscription = $this->scolariteModel->getDerniereInscription($id_etudiant);

            if (!$derniere_inscription) {
                $GLOBALS['messageErreur'] = "Aucune inscription trouvÃ©e pour cet Ã©tudiant.";
                return;
            }

            $id_niveau = $derniere_inscription['id_niveau'];
            $id_annee_acad = $derniere_inscription['id_annee_acad'];

            // RÃ©cupÃ©rer les informations de paiement
            $infos_paiement = $this->scolariteModel->getInfosPaiementEtudiant($id_etudiant, $id_annee_acad);

            if (!$infos_paiement) {
                $GLOBALS['messageErreur'] = "Impossible de rÃ©cupÃ©rer les informations de paiement.";
                return;
            }

            // VÃ©rifier si l'Ã©tudiant a dÃ©jÃ  soldÃ© sa scolaritÃ©
            if ($infos_paiement['reste_a_payer'] <= 0) {
                $GLOBALS['messageErreur'] = "Cet Ã©tudiant a dÃ©jÃ  soldÃ© sa scolaritÃ©.";
                return;
            }

            // VÃ©rifier si le montant du versement ne dÃ©passe pas le reste Ã  payer
            if ($montant > $infos_paiement['reste_a_payer']) {
                $GLOBALS['messageErreur'] = "Le montant du versement ne peut pas dÃ©passer le reste Ã  payer (" . number_format($infos_paiement['reste_a_payer'], 0, ',', ' ') . " FCFA).";
                return;
            }

            // Enregistrer le versement (crÃ©er une nouvelle ligne dans inscriptions)
            $id_inscription = $this->scolariteModel->creerInscription(
                $id_etudiant,
                $id_niveau,
                $id_annee_acad,
                $montant,
                $methode_paiement,
                $num_piece
            );

            if ($id_inscription) {
                $this->auditLog->logCreation($_SESSION['id_utilisateur'], 'inscriptions', 'SuccÃ¨s - Versement');

                // Calculer le nouveau reste Ã  payer
                $nouveau_reste = $infos_paiement['reste_a_payer'] - $montant;

                $GLOBALS['messageSuccess'] = "Versement de " . number_format($montant, 0, ',', ' ') . " FCFA enregistrÃ© avec succÃ¨s. Reste Ã  payer : " . number_format($nouveau_reste, 0, ',', ' ') . " FCFA.";

                // RafraÃ®chir les listes
                $GLOBALS['etudiantsInscrits'] = $this->scolariteModel->getEtudiantsInscrits();
            } else {
                $this->auditLog->logCreation($_SESSION['id_utilisateur'], 'inscriptions', 'Erreur - Versement');
                $GLOBALS['messageErreur'] = "Erreur lors de l'enregistrement du versement.";
            }
        } catch (Exception $e) {
            error_log("Erreur dans enregistrerVersement : " . $e->getMessage());
            $GLOBALS['messageErreur'] = "Une erreur est survenue lors de l'enregistrement du versement.";
        }
    }


    public function mettreAJourVersement()
    {
        try {
            // Validation des donnÃ©es
            if (empty($_POST['id_versement']) || empty($_POST['montant']) || empty($_POST['methode_paiement']) || empty($_POST['date_versement'])) {
                $GLOBALS['messageErreur'] = "Tous les champs obligatoires doivent Ãªtre remplis.";
                return;
            }

            // RÃ©cupÃ©rer le versement pour vÃ©rifier son type
            $versement = $this->scolariteModel->getVersementById($_POST['id_versement']);
            if (!$versement) {
                $GLOBALS['messageErreur'] = "Versement introuvable.";
                return;
            }

            // VÃ©rifier si le versement est de type "Tranche"
            if ($versement['type_versement'] !== 'Tranche') {
                $GLOBALS['messageErreur'] = "Seuls les versements de type 'Tranche' peuvent Ãªtre modifiÃ©s.";
                return;
            }

            // RÃ©cupÃ©rer l'inscription associÃ©e au versement
            $inscription = $this->scolariteModel->getInscriptionById($versement['id_inscription']);
            if (!$inscription) {
                $GLOBALS['messageErreur'] = "Inscription introuvable.";
                return;
            }

            $ancienMontant = floatval($versement['montant']);
            $nouveauMontant = floatval($_POST['montant']);
            $difference = $ancienMontant - $nouveauMontant;


            if ($ancienMontant != $nouveauMontant) {

                // VÃ©rifier si le nouveau montant total ne dÃ©passe pas le montant de scolaritÃ©
                $montantTotalPaye = floatval($inscription['montant_paye']) - $difference;
                $montantScolarite = floatval($inscription['montant_total']);

                if ($montantTotalPaye > $montantScolarite) {
                    $GLOBALS['messageErreur'] = "Le montant total des versements ne peut pas dÃ©passer le montant de scolaritÃ© (" . number_format($montantScolarite, 2) . " FCFA).";
                    return;
                }

                // PrÃ©parer les donnÃ©es de mise Ã  jour
                $data = [
                    'montant' => $nouveauMontant,
                    'difference' => $difference,
                    'methode_paiement' => $_POST['methode_paiement'],
                    'date_versement' => $_POST['date_versement']
                ];

                // Mettre Ã  jour le versement
                if ($this->scolariteModel->updateVersement($_POST['id_versement'], $data)) {
                    // Audit logging
                    $this->auditLog->logModification($_SESSION['id_utilisateur'], 'versement', 'SuccÃ¨s');

                    // RÃ©cupÃ©rer les informations mises Ã  jour
                    $inscriptionMiseAJour = $this->scolariteModel->getInscriptionById($inscription['id_inscription']);
                    if ($inscriptionMiseAJour) {
                        $GLOBALS['montantTotal'] = floatval($inscriptionMiseAJour['montant_scolarite'] ?? 0);
                        $GLOBALS['montantPaye'] = floatval($inscriptionMiseAJour['montant_paye'] ?? 0);
                        $GLOBALS['resteAPayer'] = floatval($inscriptionMiseAJour['reste_a_payer'] ?? 0);
                    }

                    $GLOBALS['messageSuccess'] = "Versement mis Ã  jour avec succÃ¨s.";
                } else {
                    $this->auditLog->logModification($_SESSION['id_utilisateur'], 'versements', 'Erreur');
                    $GLOBALS['messageErreur'] = "Erreur lors de la mise Ã  jour du versement.";
                }
            } else {
                // Si le montant n'a pas changÃ©, on met juste Ã  jour la mÃ©thode de paiement et la date
                $data = [
                    'montant' => $_POST['montant'],
                    'difference' => $difference,
                    'methode_paiement' => $_POST['methode_paiement'],
                    'date_versement' => $_POST['date_versement']
                ];

                if ($this->scolariteModel->updateVersement($_POST['id_versement'], $data)) {
                    $this->auditLog->logModification($_SESSION['id_utilisateur'], 'versements', 'SuccÃ¨s');
                    $GLOBALS['messageSuccess'] = "MÃ©thode de paiement mise Ã  jour avec succÃ¨s.";
                } else {
                    $this->auditLog->logModification($_SESSION['id_utilisateur'], 'versements', 'Erreur');
                    $GLOBALS['messageErreur'] = "Erreur lors de la mise Ã  jour de la mÃ©thode de paiement.";
                }
            }
        } catch (Exception $e) {
            error_log("Erreur dans mettreAJourVersement : " . $e->getMessage());
            $GLOBALS['messageErreur'] = "Une erreur est survenue lors de la mise Ã  jour du versement.";
        }
    }


