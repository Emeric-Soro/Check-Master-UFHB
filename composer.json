{
  "name": "ocean/projet-soutenance",
  "description": "Systeme de gestion de la commission de validation des soutenances",
  "type": "project",
  "config": {
    "platform": {
      "php": "8.1"
    }
  },
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-zip": "*",
    "phpmailer/phpmailer": "^6.10",
    "smalot/pdfparser": "^2.12",
    "phpoffice/phpword": "^1.1",
    "mpdf/mpdf": "^8.2",
    "dompdf/dompdf": "^3.1",
    "tecnickcom/tcpdf": "^6.7",
    "ezyang/htmlpurifier": "^4.19",
    "psr/log": "^1.1",
    "mpdf/psr-log-aware-trait": "^2.0",
    "phpoffice/phpspreadsheet": "^5.5"
  },
  "require-dev": {
    "symfony/var-dumper": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": ["src/", "app/"]
    },
    "classmap": [
      "app/models/",
      "app/utils/ReceiptUtils.php",
      "app/utils/EmailService.php",
      "app/utils/FormHelper.php",
      "app/utils/TableHelper.php",
      "app/utils/ComponentHelper.php",
      "app/utils/FormattingUtils.php",
      "app/utils/ExcelImportService.php"
    ],
    "files": [
      "app/utils/permissions_helper.php",
      "app/utils/PaginationHelper.php"
    ]
  }
}
