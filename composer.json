{
  "name": "ocean/projet-soutenance",
  "description": "Systeme de gestion de la commission de validation des soutenances",
  "type": "project",
  "config": {
    "platform": {
      "php": "8.4"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-zip": "*",
    "phpmailer/phpmailer": "^6.10",
    "smalot/pdfparser": "^2.12",
    "phpoffice/phpword": "^1.1",
    "mpdf/mpdf": "^8.2",
    "dompdf/dompdf": "^3.1",
    "ezyang/htmlpurifier": "^4.19",
    "psr/log": "^3.0",
    "mpdf/psr-log-aware-trait": "^3.0",
    "vlucas/valitron": "^1.4",
    "paragonie/anti-csrf": "^2.2",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.0",
    "nesbot/carbon": "^3.0",
